# Default retains the existing credential-free weather provider.
WEATHER_ADAPTER=wttr
TRANSPORT_ADAPTER=demo
EVENTS_ADAPTER=demo
# Set WEATHER_ADAPTER=demo for an entirely offline demonstration.
# Real adapters: openweather, ptv, ticketmaster. Never prefix keys NEXT_PUBLIC_.
OPENWEATHER_API_KEY=
PTV_DEVID=
PTV_API_KEY=
TICKETMASTER_API_KEY=
DATABASE_URL=sqlite:///./cityhq.db
MODEL_DIR=./artifacts
INGESTION_SECONDS=60
RETENTION_DAYS=90
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
