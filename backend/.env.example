# Exactly two cities. Credentials are server-only; never prefix them NEXT_PUBLIC_.
WEATHER_ADAPTER=open-meteo
AIR_QUALITY_ADAPTER=open-meteo-aq
TRANSPORT_ADAPTER=ptv
DELHI_TRANSPORT_ADAPTER=delhi-metro-static
EVENTS_ADAPTER=ticketmaster
# Explicit offline demo: set WEATHER_ADAPTER, AIR_QUALITY_ADAPTER,
# TRANSPORT_ADAPTER and EVENTS_ADAPTER to demo. Delhi Metro can stay static.
# Legacy Melbourne-only weather adapters: wttr, openweather.
OPENWEATHER_API_KEY=
PTV_DEVID=
PTV_API_KEY=
TICKETMASTER_API_KEY=
DATABASE_URL=sqlite:///./cityhq.db
MODEL_DIR=./artifacts
INGESTION_SECONDS=60
RETENTION_DAYS=90
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3105
